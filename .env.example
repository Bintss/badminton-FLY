# Supabase 대시보드 Connect 버튼 또는 Settings > API Keys 에서 복사
# publishable 키(sb_publishable_...)는 공개되어도 되는 값. RLS가 보호한다. secret 키는 절대 넣지 말 것
VITE_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# (예전 이름 VITE_SUPABASE_ANON_KEY 도 계속 동작)

# GitHub Pages 프로젝트 페이지면 /<레포명>/, 커스텀 도메인이면 /
VITE_BASE_PATH=/
